digraph G {
  graph [dpi=200, fontname="DejaVu Sans", nodesep=0.5, ranksep=0.45, size="9,13"];
  node [fontname="DejaVu Sans", fontsize=13, style="rounded,filled", shape=box, fillcolor="#eaf1f8", color="#2f5496"];
  edge [fontname="DejaVu Sans", fontsize=11, color="#555555"];
  start [label="Начало", shape=ellipse, fillcolor="#e2f0d9", color="#548235"];
  create [label="OrderService.createOrder:\nсоздать заказ сотрудника (статус DRAFT)"];
  in [label="Получить команду:\nadd / remove / confirm", shape=parallelogram, fillcolor="#e4e0ee", color="#7030a0"];
  kind [label="Какая команда?", shape=diamond, style="filled", fillcolor="#fff2cc", color="#bf9000"];
  a1 [label="A1: Разобрать id, наименование, цену, количество;\nпроверить: цена > 0, 1 ≤ количество ≤ 10\n(OrderItem.checkQuantity)", fillcolor="#e2f0d9", color="#2e7d32"];
  ok [label="Позиция корректна?", shape=diamond, style="filled", fillcolor="#fff2cc", color="#bf9000"];
  draft [label="Заказ в статусе DRAFT?", shape=diamond, style="filled", fillcolor="#fff2cc", color="#bf9000"];
  exists [label="Товар уже есть в заказе?", shape=diamond, style="filled", fillcolor="#fff2cc", color="#bf9000"];
  merge [label="Объединить: количество += новое;\nпосле суммы проверить ≤ 10"];
  newrow [label="Добавить новую строку OrderItem"];
  rem [label="Order.removeProduct:\nудалить строку по id товара\n(нет такого id — ошибка)"];
  a2 [label="A2: OrderService.validateForConfirm:\nзаказ в DRAFT и содержит хотя бы одну позицию;\nOrder.confirm → статус CONFIRMED", fillcolor="#e2f0d9", color="#2e7d32"];
  more [label="Есть ещё команды?", shape=diamond, style="filled", fillcolor="#fff2cc", color="#bf9000"];
  total [label="Order.total: сумма строк\n(количество × цена), округление до копеек"];
  err [label="Показать «Ошибка: ...»,\nсостав заказа не меняется"];
  end [label="Завершение", shape=ellipse, fillcolor="#fce4d6", color="#c55a11"];
  start -> create -> in -> kind;
  kind -> a1 [label="add"];
  kind -> draft [label="remove"];
  kind -> a2 [label="confirm"];
  a1 -> ok;
  ok -> draft [label="да"];
  ok -> err [label="нет"];
  draft -> exists [label="да (add)"];
  draft -> rem [label="да (remove)"];
  draft -> err [label="нет"];
  exists -> merge [label="да"];
  exists -> newrow [label="нет"];
  merge -> more;
  newrow -> more;
  rem -> more;
  a2 -> more;
  err -> more;
  more -> in [label="да"];
  more -> total [label="нет"];
  total -> end;
}
